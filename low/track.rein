import { jira } from "./jira";
import { issue } from "./issue";

interface Input {
  /** The link of the pull request with the review comments. */
  pr: string;
  /** The review round, as the script printed it, such as 4. */
  round: string;
  /** One line per open comment: its link, agree or disagree, critical, Low. */
  lines: string;
  /** One line per agreed point that is not Low, or none. */
  fix_lines: string;
  /** Is any agreed point not Low? */
  fix_points: boolean;
  /** Is any agreed point about the title or body of the pull request? */
  pr_text_points: boolean;
}

interface Tracker {
  /** Is a Jira key, such as ABC-123, in the branch name, title or body? */
  jira_linked: boolean;
}

/**
 * Pick the tracker of the Low points: the Jira ticket when the pull request
 * has a key, otherwise one GitHub issue. Each Low point is tracked before its
 * thread gets the noted reply.
 */
export default async function track({
  pr, round, lines, fix_lines, fix_points, pr_text_points,
}: Input) {
  /** Does the pull request have a Jira key to track its Low points in? */
  const tracker: Tracker = await request(`Answer jira_linked yes if a Jira
    key, such as ABC-123, is in the branch name, title or body of ${pr}.
    Otherwise answer no.`);

  if (tracker.jira_linked) {
    return jira(pr=pr, round=round, lines=lines, fix_lines=fix_lines,
      fix_points=fix_points, pr_text_points=pr_text_points);
  }

  return issue(pr=pr, round=round, lines=lines, fix_lines=fix_lines,
    fix_points=fix_points, pr_text_points=pr_text_points);
}
